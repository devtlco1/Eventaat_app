APP_NAME=Eventaat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=eventaat
DB_USERNAME=postgres
DB_PASSWORD=postgres

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Root-relative default in config/filesystems.php; set to https://yourdomain.com/storage for absolute URLs (e.g. email)
# FILESYSTEM_PUBLIC_URL=/storage
QUEUE_CONNECTION=sync

# OTP_DRIVER=log — OTP is logged only. Use OTP_DRIVER=twilio_sms or twilio_whatsapp + TWILIO_* below for Twilio channels (never commit real credentials).
OTP_DRIVER=log
# Shared Twilio credentials (SMS and/or WhatsApp OTP drivers).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio SMS OTP (only when OTP_DRIVER=twilio_sms). Messaging Service SID must be set in env, not in code.
TWILIO_MESSAGING_SERVICE_SID=
# Twilio WhatsApp OTP (only when OTP_DRIVER=twilio_whatsapp). Requires an approved WhatsApp Authentication Content Template; Content SID from Twilio console (e.g. HX...).
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Queue validity (SMS twilio_sms only; WhatsApp content-template sends omit this — see docs). 1–36000; Twilio recommends > 5 for SMS.
TWILIO_OTP_VALIDITY_PERIOD=300
# NOTIFICATION_DRIVER=dry_run — internal booking-notification dry-run provider. Planned sms/whatsapp fail fast until integrated.
NOTIFICATION_DRIVER=dry_run

# BOOKING_REMINDER_HOURS — accepted bookings starting within this many hours get one internal booking_arrival_reminder row (php artisan eventaat:booking-reminders). No SMS/WhatsApp send.
BOOKING_REMINDER_HOURS=2

# --- Ops notes (no secrets) ---
# Storage: run `php artisan storage:link` once per deployment so `public/storage` → `storage/app/public` (required for `public` disk URLs: menu PDFs, item images).
# Scheduler: Laravel does not run scheduled commands unless cron invokes `php artisan schedule:run` every minute. This app registers `eventaat:booking-reminders` hourly in `bootstrap/app.php` — confirm with `php artisan schedule:list`.

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
